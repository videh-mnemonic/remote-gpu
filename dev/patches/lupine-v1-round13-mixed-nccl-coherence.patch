+  for (const auto &mapping : mappings) {
+    if (mapping.size == 0 || mapping.server_host_ptr == 0) continue;
+    CUresult fetch_result = fetch_remote_changes(mapping);
+    if (fetch_result != CUDA_SUCCESS) return fetch_result;
