+  static auto *shadows =
+      new std::unordered_map<void *, std::vector<unsigned char>>();
+  static auto *remote_views =
+      new std::unordered_map<void *, std::vector<unsigned char>>();
+  static uint64_t step_number = 0;
+  std::lock_guard<std::mutex> coherence_lock(*shadow_mutex);
+  ++step_number;
