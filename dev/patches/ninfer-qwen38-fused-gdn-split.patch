--- a/src/ops/wrapper/scatter.cpp
+++ b/src/ops/wrapper/scatter.cpp
@@ -3,7 +3,9 @@
 #include "core/device.h"
 #include "ops/launcher/scatter.h"
 
+#include <array>
 #include <cstddef>
+#include <cstdint>
 #include <stdexcept>
 
 namespace ninfer::ops {
@@ -88,4 +90,28 @@ void extract_bf16_columns(const Tensor& source, std::int32_t source_column, Tens
                                  cudaMemcpyDeviceToDevice, stream));
 }
 
+void split_bf16_columns3(const Tensor& source, Tensor& destination0, Tensor& destination1,
+                         Tensor& destination2, cudaStream_t stream) {
+    const std::array<Tensor*, 3> destinations{&destination0, &destination1, &destination2};
+    std::int64_t rows = 0;
+    for (const Tensor* destination : destinations) {
+        if (destination->dtype != DType::BF16 || destination->ne[0] <= 0 ||
+            destination->ne[1] != source.ne[1] || destination->ne[2] != 1 ||
+            destination->ne[3] != 1 || !destination->is_contiguous() ||
+            destination->data == nullptr || (destination->ne[0] % 8) != 0 ||
+            (reinterpret_cast<std::uintptr_t>(destination->data) & 15U) != 0U) {
+            throw std::invalid_argument("split_bf16_columns3: invalid destination");
+        }
+        rows += destination->ne[0];
+    }
+    if (source.dtype != DType::BF16 || source.ne[0] != rows || source.ne[1] <= 0 ||
+        source.ne[2] != 1 || source.ne[3] != 1 || !source.is_contiguous() ||
+        source.data == nullptr || (reinterpret_cast<std::uintptr_t>(source.data) & 15U) != 0U ||
+        source.data == destination0.data || source.data == destination1.data ||
+        source.data == destination2.data) {
+        throw std::invalid_argument("split_bf16_columns3: invalid source or alias");
+    }
+    detail::split_bf16_columns3_launch(source, destination0, destination1, destination2, stream);
+}
+
 } // namespace ninfer::ops
