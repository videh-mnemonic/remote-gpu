index bb30ba3..91a1129 100644
--- a/include/ninfer/ops/scatter.h
+++ b/include/ninfer/ops/scatter.h
@@ -71,4 +71,13 @@ void scatter_bf16_batch(const Tensor& source, const Tensor& lanes, const Tensor&
 void extract_bf16_columns(const Tensor& source, std::int32_t source_column, Tensor& destination,
                           cudaStream_t stream);
 
+/**
+ * Split one contiguous BF16 [D0+D1+D2,T] tensor into three contiguous tensors
+ * [D0,T], [D1,T], and [D2,T] in one launch. All row dimensions must be divisible
+ * by eight and every pointer must be 16-byte aligned. Copies are exact and the
+ * source must not alias any destination.
+ */
+void split_bf16_columns3(const Tensor& source, Tensor& destination0, Tensor& destination1,
+                         Tensor& destination2, cudaStream_t stream);
+
 } // namespace ninfer::ops
diff --git a/src/ops/kernel/scatter.cuh b/src/ops/kernel/scatter.cuh
index 777e15a..087bd49 100644
--- a/src/ops/kernel/scatter.cuh
+++ b/src/ops/kernel/scatter.cuh
@@ -65,4 +65,28 @@ __global__ void scatter_bf16_batch_kernel(const uint4* __restrict__ source,
     }
 }
 
+__global__ void split_bf16_columns3_kernel(const uint4* __restrict__ source,
+                                           uint4* __restrict__ destination0,
+                                           uint4* __restrict__ destination1,
+                                           uint4* __restrict__ destination2,
+                                           std::int32_t vectors0, std::int32_t vectors1,
+                                           std::int32_t vectors2) {
+    const std::int32_t column = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t total  = vectors0 + vectors1 + vectors2;
+    const std::int64_t source_base = static_cast<std::int64_t>(column) * total;
+    for (std::int32_t vector = static_cast<std::int32_t>(threadIdx.x); vector < total;
+         vector += static_cast<std::int32_t>(blockDim.x)) {
+        const uint4 value = source[source_base + vector];
+        if (vector < vectors0) {
+            destination0[static_cast<std::int64_t>(column) * vectors0 + vector] = value;
+        } else if (vector < vectors0 + vectors1) {
+            const std::int32_t offset = vector - vectors0;
+            destination1[static_cast<std::int64_t>(column) * vectors1 + offset] = value;
+        } else {
+            const std::int32_t offset = vector - vectors0 - vectors1;
+            destination2[static_cast<std::int64_t>(column) * vectors2 + offset] = value;
+        }
+    }
+}
+
 } // namespace ninfer::ops
diff --git a/src/ops/launcher/scatter.cu b/src/ops/launcher/scatter.cu
index a7aada3..d52409c 100644
--- a/src/ops/launcher/scatter.cu
+++ b/src/ops/launcher/scatter.cu
@@ -46,4 +46,14 @@ void scatter_bf16_batch_launch(const Tensor& source, const Tensor& lanes,
     CUDA_CHECK(cudaGetLastError());
 }
 
+void split_bf16_columns3_launch(const Tensor& source, Tensor& destination0, Tensor& destination1,
+                                Tensor& destination2, cudaStream_t stream) {
+    constexpr int block = 256;
+    split_bf16_columns3_kernel<<<source.ne[1], block, 0, stream>>>(
+        static_cast<const uint4*>(source.data), static_cast<uint4*>(destination0.data),
+        static_cast<uint4*>(destination1.data), static_cast<uint4*>(destination2.data),
+        destination0.ne[0] / 8, destination1.ne[0] / 8, destination2.ne[0] / 8);
+    CUDA_CHECK(cudaGetLastError());
+}
+
 } // namespace ninfer::ops::detail
