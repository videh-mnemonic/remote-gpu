+int test_codex_args_and_inline_command_forms() {
+    const auto args = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<function=exec_command>\n"
+        "<parameter=args>\n[\"-c\",\"pwd && ls -la\"]\n</parameter>\n"
+        "<parameter=description>\nList files\n</parameter>\n"
+        "</function>\n</tool_call>",
+        64, {"exec_command"});
+    const auto inline_command = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<exec_command cmd=\"pwd; ls -la\" \n"
+        "</parameter>\n</function>\n</tool_call>",
+        64, {"exec_command"});
+
+    int failures = 0;
+    for (const auto* parsed : {&args, &inline_command}) {
+        failures += check(parsed->is_tool_call_response, "alternate command arguments parsed");
+        failures += check(parsed->tool_calls.size() == 1, "one alternate command parsed");
+        failures += check(parsed->tool_calls[0].name == "exec_command",
+                          "alternate command normalized");
+    }
+    failures += check(Json::parse(args.tool_calls[0].arguments_json).at("cmd") ==
+                          "pwd && ls -la",
+                      "args array command recovered");
+    failures += check(Json::parse(inline_command.tool_calls[0].arguments_json).at("cmd") ==
+                          "pwd; ls -la",
+                      "inline command recovered");
+    return failures;
+}
+
+int test_codex_missing_command_returns_retry_feedback() {
+    const auto parsed = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<function=exec_command>\ncmd\n</parameter>\n"
+        "</function>\n</tool_call>",
+        64, {"exec_command"});
+
+    int failures = 0;
+    failures += check(parsed.is_tool_call_response, "missing command becomes tool response");
+    failures += check(parsed.tool_calls.size() == 1, "one retry feedback call");
+    const Json args = Json::parse(parsed.tool_calls[0].arguments_json);
+    failures += check(args.at("cmd").get<std::string>().find("Tool-call syntax error") !=
+                          std::string::npos,
+                      "retry feedback explains malformed call");
+    return failures;
+}
