+DeviceArena& MaterializedArtifact::device_arena(std::size_t stage) {
+    if (stage == 0) { return device_arena(); }
+    const std::size_t index = stage - 1;
+    if (index >= additional_device_arenas_.size() || !additional_device_arenas_[index]) {
+        throw ArtifactError("artifact has no device tensor backing for requested stage");
+    }
+    return *additional_device_arenas_[index];
+}
+
+MaterializedArtifact materialize(const Reader& reader, const MaterializationPlan& plan,
+                                 std::span<DeviceContext* const> devices,
+                                 LoadProgress* progress) {
+    if (devices.size() < 2 || plan.device_capacities.size() != devices.size()) {
+        throw ArtifactError("pipeline materialization device geometry is invalid");
+    }
+    MaterializedArtifact out;
+    out.objects_.resize(plan.object_count);
+    out.additional_device_arenas_.resize(devices.size() - 1);
+    for (std::size_t stage = 0; stage < devices.size(); ++stage) {
+        const std::uint64_t capacity = plan.device_capacities[stage];
+        if (devices[stage] == nullptr || capacity == 0 || capacity > SIZE_MAX) {
+            throw ArtifactError("pipeline artifact tensor backing size is invalid");
+        }
+        CUDA_CHECK(cudaSetDevice(devices[stage]->device));
+        auto arena = std::make_unique<DeviceArena>(static_cast<std::size_t>(capacity));
+        if (stage == 0) {
+            out.device_arena_ = std::move(arena);
+        } else {
+            out.additional_device_arenas_[stage - 1] = std::move(arena);
+        }
+        out.stats_.device_capacity_bytes = checked_add(
+            out.stats_.device_capacity_bytes, capacity,
+            "pipeline artifact capacity overflows u64");
+    }
+    out.stats_.tensor_count   = plan.device_objects.size();
+    out.stats_.resource_count = plan.host_objects.size();
+
+    for (const HostMaterialization& placement : plan.host_objects) {
+        auto& resource            = out.objects_.at(placement.object.index).resource;
+        const PayloadSpan payload = reader.payload(reader.objects().at(placement.object.index));
+        resource.assign(payload.data.begin(), payload.data.end());
+        out.stats_.retained_resource_bytes += resource.size();
+        out.stats_.file_bytes = checked_add(out.stats_.file_bytes, resource.size(),
+                                            "artifact read bytes overflow u64");
+    }
+
+    const auto started = std::chrono::steady_clock::now();
+    std::vector<std::uint64_t> offsets(devices.size(), 0);
+    std::uint64_t copied = 0;
+    std::uint64_t total  = 0;
+    for (const DeviceMaterialization& placement : plan.device_objects) {
+        total = checked_add(total, placement.bytes, "artifact tensor byte count overflows u64");
+    }
+    for (const DeviceMaterialization& placement : plan.device_objects) {
+        if (placement.device >= devices.size()) {
+            throw ArtifactError("pipeline materialization names an invalid device stage");
+        }
+        const std::size_t stage = placement.device;
+        CUDA_CHECK(cudaSetDevice(devices[stage]->device));
+        DeviceArena& arena      = out.device_arena(stage);
+        const PayloadSpan payload = reader.payload(reader.objects().at(placement.object.index));
+        DeviceSpan storage = arena.alloc_bytes(static_cast<std::size_t>(placement.bytes),
+                                               static_cast<std::size_t>(placement.alignment));
+        const auto actual_offset = static_cast<std::uint64_t>(
+            static_cast<std::byte*>(storage.data) - static_cast<std::byte*>(arena.base()));
+        if (actual_offset != placement.offset || payload.data.size() != placement.bytes) {
+            throw ArtifactError("pipeline materialization plan does not match artifact payload");
+        }
+        out.objects_.at(placement.object.index).device = storage.data;
+        CUDA_CHECK(cudaMemcpyAsync(storage.data, payload.data.data(), payload.data.size(),
+                                   cudaMemcpyHostToDevice, devices[stage]->load_stream));
+        CUDA_CHECK(cudaStreamSynchronize(devices[stage]->load_stream));
+        if (std::getenv("NINFER_PIPELINE_VERIFY_LOAD") != nullptr) {
+            constexpr std::size_t kSampleBytes = 4096;
+            const std::size_t first_bytes = std::min(kSampleBytes, payload.data.size());
+            std::vector<std::byte> sample(first_bytes);
+            CUDA_CHECK(cudaMemcpy(sample.data(), storage.data, first_bytes,
+                                  cudaMemcpyDeviceToHost));
+            if (std::memcmp(sample.data(), payload.data.data(), first_bytes) != 0) {
+                throw ArtifactError(
+                    std::string("pipeline upload first-byte verification failed for ") +
+                    std::string(object_name(reader.objects().at(placement.object.index))));
+            }
+            if (payload.data.size() > first_bytes) {
+                const std::size_t last_bytes = std::min(kSampleBytes, payload.data.size());
+                const std::size_t last_offset = payload.data.size() - last_bytes;
+                sample.resize(last_bytes);
+                CUDA_CHECK(cudaMemcpy(sample.data(),
+                                      static_cast<const std::byte*>(storage.data) + last_offset,
+                                      last_bytes, cudaMemcpyDeviceToHost));
+                if (std::memcmp(sample.data(), payload.data.data() + last_offset, last_bytes) != 0) {
+                    throw ArtifactError(
+                        std::string("pipeline upload last-byte verification failed for ") +
+                        std::string(object_name(reader.objects().at(placement.object.index))));
+                }
+            }
+            const std::string_view name =
+                object_name(reader.objects().at(placement.object.index));
+            if (name.starts_with("text/layers/36/")) {
+                sample.resize(payload.data.size());
+                CUDA_CHECK(cudaMemcpy(sample.data(), storage.data, payload.data.size(),
+                                      cudaMemcpyDeviceToHost));
+                if (std::memcmp(sample.data(), payload.data.data(), payload.data.size()) != 0) {
+                    throw ArtifactError("pipeline upload full verification failed for " +
+                                        std::string(name));
+                }
+            }
+        }
+        copied = checked_add(copied, placement.bytes, "artifact upload bytes overflow u64");
+        if (progress != nullptr && progress->callback) {
+            progress->callback(object_name(reader.objects().at(placement.object.index)), copied,
+                               total);
+        }
+        offsets[stage] = placement.offset + placement.bytes;
+    }
+    out.stats_.file_bytes = checked_add(out.stats_.file_bytes, copied,
+                                        "artifact read bytes overflow u64");
+    out.stats_.h2d_bytes = copied;
+    out.stats_.upload_seconds = std::chrono::duration<double>(
+                                    std::chrono::steady_clock::now() - started)
+                                    .count();
+    CUDA_CHECK(cudaSetDevice(devices.front()->device));
+    return out;
+}
+
 MaterializedArtifact materialize(const Reader& reader, const MaterializationPlan& plan,
                                  DeviceContext& device, LoadProgress* progress) {
     MaterializedArtifact out;
