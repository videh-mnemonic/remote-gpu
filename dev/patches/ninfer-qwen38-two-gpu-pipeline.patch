+std::optional<int> pipeline_device_from_environment() {
+    const char* raw = std::getenv("NINFER_PIPELINE_DEVICE");
+    if (raw == nullptr || *raw == '\0') { return std::nullopt; }
+    int value = -1;
+    const char* end = raw + std::char_traits<char>::length(raw);
+    const auto parsed = std::from_chars(raw, end, value);
+    if (parsed.ec != std::errc{} || parsed.ptr != end || value < 0) {
+        throw std::invalid_argument("NINFER_PIPELINE_DEVICE must be a non-negative integer");
+    }
+    return value;
+}
+
+std::optional<std::uint32_t> text_layer(std::string_view name) {
+    constexpr std::string_view prefix = "text/layers/";
+    if (!name.starts_with(prefix)) { return std::nullopt; }
+    name.remove_prefix(prefix.size());
+    const std::size_t slash = name.find('/');
+    if (slash == std::string_view::npos) { return std::nullopt; }
+    std::uint32_t layer = 0;
+    const auto parsed = std::from_chars(name.data(), name.data() + slash, layer);
+    if (parsed.ec != std::errc{} || parsed.ptr != name.data() + slash) { return std::nullopt; }
+    return layer;
+}
+
+artifact::MaterializationPlan pipeline_weight_plan(
+    const artifact::Reader& reader, const artifact::MaterializationPlan& source) {
+    constexpr std::uint32_t split = 32;
+    artifact::MaterializationPlan out = source;
+    out.device_capacities.assign(2, 0);
+    for (artifact::DeviceMaterialization& placement : out.device_objects) {
+        const std::string_view name = artifact::object_name(
+            reader.objects().at(placement.object.index));
+        const auto layer = text_layer(name);
+        placement.device = layer && *layer >= split ? 1U : 0U;
+        std::uint64_t& capacity = out.device_capacities[placement.device];
+        const std::uint64_t mask = placement.alignment - 1;
+        if (capacity > std::numeric_limits<std::uint64_t>::max() - mask) {
+            throw artifact::ArtifactError("pipeline materialization plan overflows u64");
+        }
+        placement.offset = (capacity + mask) & ~mask;
+        if (placement.bytes > std::numeric_limits<std::uint64_t>::max() - placement.offset) {
+            throw artifact::ArtifactError("pipeline materialization plan overflows u64");
+        }
+        capacity = placement.offset + placement.bytes;
+    }
+    out.device_capacity_bytes = out.device_capacities.front();
+    return out;
+}
