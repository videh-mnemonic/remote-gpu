@@ -0,0 +1,84 @@
+#pragma once
+
+#include <stdint.h>
+
+enum lupine_cublas_opcode : uint32_t {
+  LUPINE_CUBLAS_CREATE = 1,
+  LUPINE_CUBLAS_DESTROY = 2,
+  LUPINE_CUBLAS_SET_STREAM = 3,
+  LUPINE_CUBLAS_SET_WORKSPACE = 4,
+  LUPINE_CUBLAS_SET_MATH_MODE = 5,
+  LUPINE_CUBLAS_SET_POINTER_MODE = 6,
+  LUPINE_CUBLAS_SGEMM = 7,
+  LUPINE_CUBLAS_GEMM_EX = 8,
+  LUPINE_CUBLAS_SGEMM_EX = 9,
+  LUPINE_CUBLAS_LT_MATMUL_DESC_CREATE = 10,
+  LUPINE_CUBLAS_LT_MATMUL_DESC_DESTROY = 11,
+  LUPINE_CUBLAS_LT_MATMUL_DESC_SET_ATTRIBUTE = 12,
+  LUPINE_CUBLAS_LT_MATRIX_LAYOUT_CREATE = 13,
+  LUPINE_CUBLAS_LT_MATRIX_LAYOUT_DESTROY = 14,
+  LUPINE_CUBLAS_LT_MATRIX_LAYOUT_SET_ATTRIBUTE = 15,
+  LUPINE_CUBLAS_LT_PREFERENCE_CREATE = 16,
+  LUPINE_CUBLAS_LT_PREFERENCE_DESTROY = 17,
+  LUPINE_CUBLAS_LT_PREFERENCE_SET_ATTRIBUTE = 18,
+  LUPINE_CUBLAS_LT_HEURISTIC = 19,
+  LUPINE_CUBLAS_LT_MATMUL = 20,
+};
+
+struct lupine_cublas_request {
+  uint32_t opcode = 0;
+  uint64_t handle = 0;
+  uint64_t stream = 0;
+  uint64_t workspace = 0;
+  uint64_t workspace_size = 0;
+  uint64_t a = 0;
+  uint64_t b = 0;
+  uint64_t c = 0;
+  uint64_t d = 0;
+  int32_t transa = 0;
+  int32_t transb = 0;
+  int32_t m = 0;
+  int32_t n = 0;
+  int32_t k = 0;
+  int32_t lda = 0;
+  int32_t ldb = 0;
+  int32_t ldc = 0;
+  int32_t value = 0;
+  float alpha = 0.0f;
+  float beta = 0.0f;
+  int32_t a_type = 0;
+  int32_t b_type = 0;
+  int32_t c_type = 0;
+  int32_t compute_type = 0;
+  int32_t algorithm = 0;
+  uint32_t scalar_size = 0;
+  uint8_t alpha_data[16] = {};
+  uint8_t beta_data[16] = {};
+  uint64_t descriptor = 0;
+  uint64_t a_descriptor = 0;
+  uint64_t b_descriptor = 0;
+  uint64_t c_descriptor = 0;
+  uint64_t d_descriptor = 0;
+  uint64_t preference = 0;
+  uint64_t rows = 0;
+  uint64_t columns = 0;
+  int64_t leading_dimension = 0;
+  int32_t attribute = 0;
+  int32_t requested_algorithms = 0;
+  uint32_t payload_size = 0;
+  uint8_t payload[128] = {};
+  uint64_t context = 0;
+};
+
+struct lupine_cublas_response {
+  int32_t status = 13;
+  int32_t value = 0;
+  uint64_t handle = 0;
+  int32_t returned_algorithms = 0;
+  uint32_t payload_size = 0;
+  uint8_t payload[768] = {};
+};
+
+extern "C" int lupine_cublas_call_on_route(
+    int route_id, const lupine_cublas_request *request,
+    lupine_cublas_response *response);
