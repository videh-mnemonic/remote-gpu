+// Context limits are stable until cuCtxSetLimit mutates them.  PyTorch asks
+// for the same limits repeatedly while selecting kernels, so serving those
+// queries from the client avoids an otherwise unavoidable network round trip.
+struct lupine_ctx_limit_cache_key {
+  int route_id;
+  CUcontext context;
+  CUlimit limit;
+
+  bool operator==(const lupine_ctx_limit_cache_key &other) const {
+    return route_id == other.route_id && context == other.context &&
+           limit == other.limit;
+  }
+};
+
+struct lupine_ctx_limit_cache_hash {
+  size_t operator()(const lupine_ctx_limit_cache_key &key) const {
+    size_t value = std::hash<int>{}(key.route_id);
+    value ^= std::hash<void *>{}(key.context) + 0x9e3779b9 + (value << 6) +
+             (value >> 2);
+    value ^= std::hash<int>{}(static_cast<int>(key.limit)) + 0x9e3779b9 +
+             (value << 6) + (value >> 2);
+    return value;
+  }
+};
+
+static std::mutex &lupine_ctx_limit_cache_mutex() {
+  static auto *mutex = new std::mutex();
+  return *mutex;
+}
+
+static std::unordered_map<lupine_ctx_limit_cache_key, size_t,
+                          lupine_ctx_limit_cache_hash> &
+lupine_ctx_limit_cache() {
+  static auto *cache =
+      new std::unordered_map<lupine_ctx_limit_cache_key, size_t,
+                             lupine_ctx_limit_cache_hash>();
+  return *cache;
+}
+
+extern "C" void lupine_invalidate_ctx_limit_cache() {
+  std::lock_guard<std::mutex> lock(lupine_ctx_limit_cache_mutex());
+  lupine_ctx_limit_cache().clear();
+}
