 }
 
+int test_codex_alternate_function_open() {
+    const ninfer::serve::ParsedToolCallOutput parsed =
+        ninfer::serve::parse_qwen_tool_call_output("I'll inspect it.\n"
+                                                   "<tool_call>\n"
+                                                   "<exec_command>\n"
+                                                   "<parameter=cmd>\npwd\n</parameter>\n"
+                                                   "</function>\n"
+                                                   "</tool_call>",
+                                                   64);
+
+    int failures = 0;
+    failures += check(parsed.is_tool_call_response, "Codex alternate call parsed as tool response");
+    failures += check(parsed.content == "I'll inspect it.", "Codex content prefix trimmed");
+    failures += check(parsed.tool_calls.size() == 1, "one Codex call parsed");
+    failures += check(parsed.tool_calls[0].name == "exec_command", "Codex function name parsed");
+    const Json args = Json::parse(parsed.tool_calls[0].arguments_json);
+    failures += check(args.at("cmd") == "pwd", "Codex command parameter parsed");
+    return failures;
+}
+
+int test_codex_malformed_variants() {
+    const auto missing_delimiter = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<function=exec_command\n<parameter=cmd>\npwd\n</parameter>\n"
+        "</function>\n</tool_call>",
+        64);
+    const auto alias = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<execution>\n<parameter=command>\npwd\n</parameter>\n"
+        "</function>\n</tool_call>",
+        64);
+    const auto command_block = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<command>\npwd\n</command>\n<tool_call>\n<command>\nignored\n"
+        "</command>\n</function>\n</tool_call>",
+        64);
+    const auto assignment = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<function=exec_command>\ncmd=\"echo \\\"hello\\\"\n\"\n"
+        "</parameter>\n<name>junk</name>\n</function>\n</tool_call>",
+        64);
+
+    int failures = 0;
+    for (const auto* parsed : {&missing_delimiter, &alias, &command_block, &assignment}) {
+        failures += check(parsed->is_tool_call_response, "malformed Codex variant recovered");
+        failures += check(parsed->tool_calls.size() == 1, "one recovered Codex call");
+        failures += check(parsed->tool_calls[0].name == "exec_command",
+                          "recovered Codex call normalized");
+    }
+    failures += check(Json::parse(missing_delimiter.tool_calls[0].arguments_json).at("cmd") ==
+                          "pwd",
+                      "missing delimiter command recovered");
+    failures += check(Json::parse(alias.tool_calls[0].arguments_json).at("cmd") == "pwd",
+                      "execution alias and argument recovered");
+    failures += check(Json::parse(command_block.tool_calls[0].arguments_json).at("cmd") == "pwd",
+                      "command block recovered");
+    failures += check(Json::parse(assignment.tool_calls[0].arguments_json).at("cmd") ==
+                          "echo \\\"hello\\\"\n",
+                      "assignment command recovered");
+    return failures;
+}
