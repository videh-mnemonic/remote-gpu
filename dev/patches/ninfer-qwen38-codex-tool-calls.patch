     return true;
 }
 
+bool parse_codex_command_fallback(std::string_view params, Json& args) {
+    constexpr std::string_view kCommandOpen  = "<command>";
+    constexpr std::string_view kCommandClose = "</command>";
+    const std::size_t first_open  = params.find(kCommandOpen);
+    const std::size_t first_close = params.find(kCommandClose);
+    if (first_close != std::string_view::npos &&
+        (first_open == std::string_view::npos || first_close < first_open)) {
+        args["cmd"] = trim_ascii(params.substr(0, first_close));
+        return true;
+    }
+    if (const std::size_t open = first_open; open != std::string_view::npos) {
+        const std::size_t begin = open + kCommandOpen.size();
+        const std::size_t end   = params.find(kCommandClose, begin);
+        if (end != std::string_view::npos) {
+            args["cmd"] = trim_ascii(params.substr(begin, end - begin));
+            return true;
+        }
+    }
+    constexpr std::string_view kCmdAssign = "cmd=\"";
+    const std::size_t assign = params.find(kCmdAssign);
+    if (assign == std::string_view::npos) { return false; }
+    const std::size_t begin = assign + kCmdAssign.size();
+    const std::size_t parameter_end = params.find("</parameter>", begin);
+    const std::size_t search_end =
+        parameter_end == std::string_view::npos ? params.size() : parameter_end;
+    const std::size_t end = params.rfind('"', search_end);
+    if (end == std::string_view::npos || end < begin) { return false; }
+    args["cmd"] = std::string(params.substr(begin, end - begin));
+    return true;
+}
