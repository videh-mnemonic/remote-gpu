+        rpc_write_start_request(conn, RPC_cuDriverGetVersion) < 0 ||
+        rpc_wait_for_response(conn) < 0 ||
+        rpc_read(conn, driverVersion, sizeof(int)) < 0 ||
+        rpc_read(conn, &return_value, sizeof(CUresult)) < 0 ||
+        rpc_read_end(conn) < 0)
