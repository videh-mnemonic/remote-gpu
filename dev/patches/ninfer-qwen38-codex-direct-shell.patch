+int test_codex_shell_command_as_function_name() {
+    const auto parsed = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<function=pwd>\n</function>\n</tool_call>\n"
+        "<tool_call>\n<function=ls -la\n</function>\n</tool_call>",
+        64, {"exec_command", "list_mcp_resources"});
+
+    int failures = 0;
+    failures += check(parsed.is_tool_call_response, "direct shell commands parsed");
+    failures += check(parsed.tool_calls.size() == 2, "two direct shell commands parsed");
+    failures += check(parsed.tool_calls[0].name == "exec_command", "pwd normalized");
+    failures += check(parsed.tool_calls[1].name == "exec_command", "ls normalized");
+    failures += check(Json::parse(parsed.tool_calls[0].arguments_json).at("cmd") == "pwd",
+                      "pwd command recovered");
+    failures += check(Json::parse(parsed.tool_calls[1].arguments_json).at("cmd") == "ls -la",
+                      "ls command recovered");
+    return failures;
+}
