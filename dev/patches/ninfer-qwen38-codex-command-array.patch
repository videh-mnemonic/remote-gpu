+std::string shell_quote(std::string_view value) {
+    if (value.empty()) { return "''"; }
+    const bool safe = std::all_of(value.begin(), value.end(), [](unsigned char c) {
+        return std::isalnum(c) != 0 || c == '_' || c == '-' || c == '.' || c == '/' || c == ':';
+    });
+    if (safe) { return std::string(value); }
+    std::string quoted{"'"};
+    for (const char c : value) {
+        if (c == '\'') {
+            quoted += "'\\''";
+        } else {
+            quoted += c;
+        }
+    }
+    quoted += '\'';
+    return quoted;
+}
+
+bool normalize_command_array(Json& value) {
+    if (!value.is_array() || value.empty()) { return false; }
+    std::vector<std::string> parts;
+    parts.reserve(value.size());
+    for (const Json& part : value) {
+        if (!part.is_string()) { return false; }
+        parts.push_back(part.get<std::string>());
+    }
+    if (parts.size() >= 3 &&
+        (parts[0] == "bash" || parts[0] == "/bin/bash" || parts[0] == "sh" ||
+         parts[0] == "/bin/sh") &&
+        (parts[1] == "-c" || parts[1] == "-lc")) {
+        value = parts[2];
+        return true;
+    }
+    std::string command;
+    for (const std::string& part : parts) {
+        if (!command.empty()) { command += ' '; }
+        command += shell_quote(part);
+    }
+    value = std::move(command);
+    return true;
+}
