+int test_codex_shell_alias_and_progress_retry() {
+    const auto alias = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n<function=Bash>\n"
+        "<parameter=command>\npwd\n</parameter>\n</function>\n</tool_call>",
+        64, {"exec_command"});
+    const auto progress = ninfer::serve::parse_qwen_tool_call_output(
+        "Let me explore the project structure to understand what's tracked.", 64,
+        {"exec_command"});
+    const auto malformed = ninfer::serve::parse_qwen_tool_call_output(
+        "<tool_call>\n", 64, {"exec_command"});
+
+    int failures = 0;
+    failures += check(alias.is_tool_call_response, "Bash alias parsed");
+    failures += check(alias.tool_calls[0].name == "exec_command", "Bash alias normalized");
+    failures += check(Json::parse(alias.tool_calls[0].arguments_json).at("cmd") == "pwd",
+                      "Bash command preserved");
+    for (const auto* parsed : {&progress, &malformed}) {
+        failures += check(parsed->is_tool_call_response, "incomplete response becomes retry");
+        failures += check(parsed->tool_calls.size() == 1, "one continuation feedback call");
+        failures += check(parsed->tool_calls[0].name == "exec_command",
+                          "continuation uses available command tool");
+    }
+    return failures;
+}
