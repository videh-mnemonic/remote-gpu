+                f.write("    if (return_value == CUDA_SUCCESS && pciBusId != nullptr && len > 0) {\n")
+                f.write("        const char *lupine_separator = std::strchr(pciBusId, ':');\n")
+                f.write("        if (lupine_separator != nullptr) {\n")
