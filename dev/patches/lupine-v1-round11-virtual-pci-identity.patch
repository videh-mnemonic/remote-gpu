+            std::snprintf(pciBusId, static_cast<std::size_t>(len), "%08x%s", lupine_virtual_domain, lupine_physical_suffix);
+        }
+    }
     lupine_mark_host_range_clean(pciBusId, len * sizeof(char));
     return return_value;
 }
