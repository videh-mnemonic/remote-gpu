diff --git a/codegen/gen_client.cpp b/codegen/gen_client.cpp
--- a/codegen/gen_client.cpp
+++ b/codegen/gen_client.cpp
@@ -1252,6 +1252,15 @@ extern "C" CUresult cuDeviceGetPCIBusId(char *pciBusId, int len, CUdevice dev) {
         rpc_read(conn, &return_value, sizeof(CUresult)) < 0 ||
         rpc_read_end(conn) < 0)
         return CUDA_ERROR_DEVICE_UNAVAILABLE;
+    if (return_value == CUDA_SUCCESS && pciBusId != nullptr && len > 0) {
+        const char *lupine_separator = std::strchr(pciBusId, ':');
+        if (lupine_separator != nullptr) {
